# Agent generated files (keep documentation, exclude actual generated mockups unless intentional)
# Uncomment the line below if you want to exclude generated mockups from version control
# designs/*.png
# designs/*.svg

# Temporary agent execution files
*.tmp
.agent-cache/
.workflow-cache/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules if future expansion includes JavaScript tooling
node_modules/
package-lock.json

# Python cache if future expansion includes Python tooling
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Build artifacts
dist/
build/
*.egg-info/

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
